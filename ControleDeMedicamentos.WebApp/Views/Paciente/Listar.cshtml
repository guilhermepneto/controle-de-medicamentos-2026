@using ControleDeMedicamentos.WebApp.ModuloFornecedores
@using ControleDeMedicamentos.WebApp.ModuloPacientes

@model List<Paciente>

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Inicio</a> /
<a href="/Fornecedor/Listar">Fornecedores</a> /
<a href="/Medicamento/Listar">Medicamentos</a> /
<a href="/Funcionario/Listar">Funcionários</a> /
<a href="/Paciente/Listar">Pacientes</a> /
<hr />

<h1>Listagem de Pacientes</h1>

<p>
    <a href="Cadastrar">Cadastrar Paciente</a>
</p>

<table>
    <thead>
        <tr>
        </tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Cartão SUS</th>
        <th>CPF</th>
        <th>Ações</th>
    </thead>

    <tbody>
        @foreach (Paciente p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Telefone</td>
                <td>@p.CartaoSus</td>
                <td>@p.Cpf</td>
                <td>
                    <a href="Editar/@p.Id">Editar</a>
                    <span> | <span>
                        <a href="Excluir/@p.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
