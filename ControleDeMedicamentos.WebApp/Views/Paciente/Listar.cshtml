@model List<ListarPacienteViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Pacientes";
}

<p>
    <a href="Cadastrar">Cadastrar Paciente</a>
</p>

<table>
    <thead>
        <tr>
        </tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Cartão SUS</th>
        <th>Ações</th>
    </thead>

    <tbody>
        @foreach (ListarPacienteViewModel p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Telefone</td>
                <td>@p.CartaoSus</td>
                <td>
                    <a href="Editar/@p.Id">Editar</a>
                    <span> | <span>
                        <a href="Excluir/@p.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
