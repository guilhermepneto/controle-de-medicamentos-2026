@model Medicamento;


@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Medicamentos";
}

<form action="/Medicamento/Excluir/@Model.Id" method="post">

    <p>Você deseja excluir o registro "@Model.Nome"? Não é possível reverter.
    </p>

    <button type="submit">Confirmar</button>

</form>

<p>
    <a href="/Medicamento/Listar">Voltar para a Lista</a>
</p>
