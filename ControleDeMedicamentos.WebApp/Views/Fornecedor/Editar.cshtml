@model EditarFornecedorViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Fornecedores";
}

<div class="row justify-content-start">
    <form class="col-lg-6" action="/Fornecedor/Editar/@Model.Id" method="post">

        <div>
            <label class="form-label" for="nome">Nome</label>
            <input class="form-control" id="nome" name="nome" type="text" value="@Model.Nome">
        </div>

        <div class="mt-4">
            <label class="form-label" for="telefone">Telefone</label>
            <input class="form-control" id="telefone" name="telefone" type="text" value="@Model.Telefone">
        </div>

        <div class="mt-4">
            <label class="form-label" for="cnpj">CNPJ</label>
            <input class="form-control" id="cnpj" name="cnpj" type="text" value="@Model.Cnpj">
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">Confirmar</button>
            <a class="btn btn-outline-secondary" href="/Fornecedor/Listar">Voltar para a lista</a>
        </div>
    </form>
</div>
