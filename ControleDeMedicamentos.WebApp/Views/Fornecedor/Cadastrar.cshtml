@model CadastrarFornecedorViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Fornecedores";
}

<form asp-action="Cadastrar" method="post">

    <div>
        <label asp-for="Nome"></label>
        <br />
        <input asp-for="Nome" type="text">
    </div>

    <div>
        <label asp-for="Telefone"></label>
        <br />
        <input asp-for="Telefone" type="text">
    </div>

    <div>
        <label asp-for="Cnpj">CNPJ</label>
        <br />
        <input asp-for="Cnpj" type="text">
    </div>

    <button type="submit">Cadastrar</button>

</form>

<p>
    <a asp-action="Listar">Voltar para a Lista</a>
</p>
