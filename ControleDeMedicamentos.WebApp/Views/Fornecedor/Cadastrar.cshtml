@model CadastrarFornecedorViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Fornecedores";
}

<div class="row justify-content-start">
    <form class="col-lg-6" action="/Fornecedor/Cadastrar" method="post">

        <div>
            <label class="form-label" for="nome">Nome</label>
            <input class="form-control" id="nome" name="nome" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" for="telefone">Telefone</label>
            <input class="form-control" id="telefone" name="telefone" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" for="cnpj">CNPJ</label>
            <input class="form-control" id="cnpj" name="cnpj" type="text">
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                Cadastrar
                <i class="bi bi-check-square"></i>
            </button>
            <a class="btn btn-outline-secondary" href="/Fornecedor/Listar">Voltar para a lista
                <i class="bi bi-arrow-return-left"></i>
            </a>
        </div>
    </form>
</div>

