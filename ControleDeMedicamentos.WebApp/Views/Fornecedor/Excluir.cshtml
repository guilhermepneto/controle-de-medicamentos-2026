@model ExcluirFornecedorViewModel;

<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Início</a> / @* Âncora ou Link *@
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> / @* Âncora ou Link *@
<a asp-controller="Medicamento" asp-action="Listar">Medicamentos</a> / @* Âncora ou Link *@
<a asp-controller="Funcionario" asp-action="Listar">Funcionários</a> / @* Âncora ou Link *@
<hr />

<h1>Exclusão de Fornecedores</h1>

<form asp-action="Excluir" asp-route-id="@Model.Id" method="post">

    <p>Você realmente deseja excluir o registro abaixo?</p>

    <div>
        <label asp-for="Nome"></label>
        <br />
        <input asp-for="Nome" type="text" readonly>
    </div>

    <button type="submit">Confirmar</button>

</form>

<p>
    <a asp-action="Listar">Voltar para a Lista</a>
</p>

