@model List<ListarFornecedorViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Fornecedores";
}

<p>
    <a href="Cadastrar">Cadastrar Fornecedores</a>
</p>

<table>
    <thead>
        <tr>
        </tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Cnpj</th>
        <th>Ações</th>
    </thead>

    <tbody>
        @foreach (ListarFornecedorViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>@f.Cnpj</td>
                <td>
                    <a href="Editar/@f.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@f.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
