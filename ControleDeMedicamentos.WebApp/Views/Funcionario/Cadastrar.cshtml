@model CadastrarFuncionarioViewModel;

<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Inicio</a> /
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> /
<a asp-controller="Medicamento" asp-action="Listar">Medicamento</a> /
<a asp-controller="Funcionario" asp-action="Listar">Funcionários</a> /
<hr />

<h1>Cadastro de Funcionários</h1>

<form asp-action="Cadastrar" method="post">

    <div>
        <label asp-for="Nome"></label>
        <br />
        <input asp-for="Nome" type="text">
    </div>

    <div>
        <label asp-for="Telefone"></label>
        <br />
        <input asp-for="Telefone" type="text">
    </div>

    <div>
        <label asp-for="Cpf">CPF</label>
        <br />
        <input asp-for="Cpf" type="text">
    </div>

    <button type="submit">Cadastrar</button>

</form>

<p>
    <a asp-action="Listar">Voltar para a Lista</a>
</p>
