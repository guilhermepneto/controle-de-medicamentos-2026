@using ControleDeMedicamentos.WebApp.ModuloFuncionario

@model Funcionario;

<h2>Controle de Funcionários</h2>

<hr />
<a href="/">Inicio</a> /
<a href="/Funcionario/Listar">Fornecedores</a> /
<hr />

<h1>Edição de Funcionario</h1>

<form action="/Funcionario/Editar/@Model.Id" method="post">

    <div>
        <label for="nome">Nome</label>
        <input id="nome" name="Nome" type="text" value="@Model.Nome">
    </div>

    <div>
        <label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="text" value="@Model.Telefone">
    </div>

    <div>
        <label for="cpf">CPF</label>
        <input id="cpf" name="cpf" type="text" value="@Model.Cpf">
    </div>

    <button type="submit">Confirmar</button>

</form>

<p>
    <a href="/Funcionario/Listar">Voltar para a Lista</a>
</p>
