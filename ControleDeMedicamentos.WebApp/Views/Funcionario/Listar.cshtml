@model List<ListarFuncionarioViewModel>

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Inicio</a> /
<a href="/Fornecedor/Listar">Fornecedores</a> /
<a href="/Medicamento/Listar">Medicamentos</a> /
<a href="/Funcionario/Listar">Funcionários</a> /
<a href="/Paciente/Listar">Pacientes</a> /

<hr />

<h1>Listagem de Funcionarios</h1>

<p>
    <a href="Cadastrar">Cadastrar Funcionarios</a>
</p>

<table>
    <thead>
        <tr>
        </tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Ações</th>
    </thead>

    <tbody>
        @foreach (ListarFuncionarioViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="Editar/@f.Id">Editar</a>
                    <span> | <span>
                        <a href="Excluir/@f.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
