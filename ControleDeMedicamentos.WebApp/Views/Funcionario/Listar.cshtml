@model List<ListarFuncionarioViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Funcionarios";
}

<p>
    <a href="Cadastrar">Cadastrar Funcionarios</a>
</p>

<table>
    <thead>
        <tr>
        </tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Ações</th>
    </thead>

    <tbody>
        @foreach (ListarFuncionarioViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="Editar/@f.Id">Editar</a>
                    <span> | <span>
                        <a href="Excluir/@f.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
